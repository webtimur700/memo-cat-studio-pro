# Скопировать в .env и при необходимости поправить.
# Ничего секретного здесь нет — приложение полностью локальное, ключи API не нужны.

# --- LLM (LM Studio) ---
# LM Studio по умолчанию поднимает локальный сервер на этом порту при "Start Server".
LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_REQUEST_TIMEOUT_SEC=300
# Модель выбирается автоматически (llm/model_selector.py): лучшая по замерам docs/llm_benchmark.md из
# помещающихся в свободную память с запасом под пайплайн; embedding-модели исключаются; выбранную модель
# приложение само загружает через REST с небольшим контекстом и выгружает после обработки.
# LM_STUDIO_MODEL_OVERRIDE (id модели из LM Studio) имеет приоритет над автовыбором.
LM_STUDIO_MODEL_OVERRIDE=
# Рассуждения выключены (для коротких заголовков они дают только задержку в минуты). Пусто — как в рейтинге
# (none); "low"/"medium"/... — принудительно; для моделей без управления рассуждениями параметр не отправляется.
LM_STUDIO_REASONING_EFFORT=
# Контекст при загрузке модели приложением (по умолчанию LM Studio берёт 262144 — гигабайты KV-кэша впустую).
LM_STUDIO_CONTEXT_LENGTH=8192
# 1 — отправлять кадр обложки vision-модели (заголовки конкретнее); 0 — только текст.
LM_STUDIO_USE_VISION=1
# 0 — не выбирать и не загружать модели самому (как раньше: модель, которую загрузили вы / JIT-загрузка LM Studio).
LM_STUDIO_MANAGE_MODELS=1

# --- Ollama (опциональный альтернативный провайдер, см. llm/ollama_provider.py) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Пути ---
DB_PATH=database/memo_cat.db
ASSETS_PATH=assets/
EXPORT_PATH=export/output/
LOGS_PATH=logs/

# --- Вычислительный профиль (см. config/compute_profiles.yaml) ---
COMPUTE_PROFILE=default

# --- Режим приложения ---
APP_ENV=production
LOG_LEVEL=INFO
