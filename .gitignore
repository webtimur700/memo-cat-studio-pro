```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Test cache
.pytest_cache/
__pycache__/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Temporary files
*.tmp
*.swp
*.swo

# Coverage reports
.coverage
htmlcov/
coverage/

# IDE specific
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db
```